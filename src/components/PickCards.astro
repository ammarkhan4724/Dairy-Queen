---
// Image cards for "top picks" sections on hub pages. Images come from /Images/<slug>.webp.
interface Pick { href: string; img: string; name: string; price?: string; note?: string }
interface Props { picks: Pick[] }

const { picks } = Astro.props;
---
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:16px;margin:20px 0 28px;">
  {picks.map((p) => (
    <a href={p.href} style="display:block;background:#FFFFFF;border:1px solid #EADBCA;border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;">
      <img src={p.img} alt={`Dairy Queen ${p.name}`} width="300" height="300" loading="lazy" style="width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;display:block;" />
      <span style="display:block;padding:10px 12px 12px;">
        <strong style="display:block;font-size:.95rem;color:#0B1E38;line-height:1.3;">{p.name}</strong>
        {p.price && <span style="display:block;font-weight:700;color:#0E7490;margin-top:2px;">{p.price}</span>}
        {p.note && <span style="display:block;font-size:.82rem;color:var(--color-text-muted);margin-top:2px;">{p.note}</span>}
      </span>
    </a>
  ))}
</div>
