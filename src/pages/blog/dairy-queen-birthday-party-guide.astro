---
import BlogPost from '../../layouts/BlogPost.astro';

// Prices are the typical U.S. prices on our item pages; servings match /categories/dq-cakes.
const budgets = [
  { kids: '10', cake: '8-inch round ($22.99, serves 8–10)', treatsOnly: '$40.89', withMeals: '$72.89' },
  { kids: '15', cake: '10-inch round ($32.99, serves 12–16)', treatsOnly: '$59.84', withMeals: '$107.84' },
  { kids: '20', cake: 'Sheet cake ($44.99, serves 20–25)', treatsOnly: '$80.79', withMeals: '$144.79' },
  { kids: '30', cake: 'Sheet + 10-inch ($77.98, serves 32–41)', treatsOnly: '$131.68', withMeals: '$227.68' },
];

const faqs = [
  { q: 'How much does a Dairy Queen birthday party cost?', a: 'For 10 kids, about $41 for an 8-inch cake plus a Kids’ cone each, or about $73 with a $4.99 kids meal each instead of cones. For 20 kids, plan on about $81 for a sheet cake and cones, or about $145 with kids meals. Prices vary by location.' },
  { q: 'What size DQ cake do I need for a birthday party?', a: 'An 8-inch round for up to 10 guests, a 10-inch for 12 to 16, and a sheet cake for 20 to 25. For 30 or more, pair a sheet cake with a 10-inch round.' },
  { q: 'Can you have a birthday party at Dairy Queen?', a: 'It depends on the store. Dairy Queen does not run a national party package, but some franchise locations will reserve tables or set up group orders. Call your local store and ask.' },
  { q: 'How long can a DQ cake sit out at a party?', a: 'Keep it in the freezer until about 10 to 15 minutes before you cut it. It is an ice cream cake, so serve it soon after cutting and put leftovers back in the freezer right away.' },
  { q: 'Does Dairy Queen give a free birthday treat?', a: 'If you add your birthday to your DQ Rewards profile in the app, DQ usually sends a birthday treat offer. Set it up a few weeks before the birthday.' },
