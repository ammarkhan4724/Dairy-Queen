        <tr><td><strong>Small vanilla cone</strong></td><td class="price-cell">$1.79</td><td>170</td><td>The classic curl on top</td></tr>
        <tr><td><strong><a href="/items/dilly-bar">Dilly Bar</a></strong></td><td class="price-cell">$1.99</td><td>210</td><td>Round bar on a stick, chocolate shell</td></tr>
        <tr><td><strong><a href="/items/non-dairy-dilly-bar">Non-Dairy Dilly Bar</a></strong></td><td class="price-cell">$2.49</td><td>220</td><td>Made without milk</td></tr>
        <tr><td><strong><a href="/items/chocolate-dipped-cone">Chocolate dipped cone</a></strong> (regular)</td><td class="price-cell">$3.19</td><td>330</td><td>The shell is fun to crack</td></tr>
        <tr><td><strong>Mini <a href="/items/oreo-blizzard">Oreo Blizzard</a></strong></td><td class="price-cell">$3.49</td><td>~300</td><td>Mild, familiar cookie flavor</td></tr>
        <tr><td><strong>Mini <a href="/items/mm-blizzard">M&amp;M’s Blizzard</a></strong></td><td class="price-cell">$3.49</td><td>~310</td><td>Colorful, crunchy candy</td></tr>
