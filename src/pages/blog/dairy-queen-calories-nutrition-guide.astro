              <th>Dietary Assessment</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><a href="/items/grilled-chicken-sandwich"><strong>Grilled Chicken (No Mayo)</strong></a></td>
              <td>320 cal</td>
              <td><strong>36g</strong></td>
