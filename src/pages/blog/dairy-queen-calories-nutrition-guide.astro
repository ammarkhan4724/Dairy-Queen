              <td><strong class="text-cyan-700">5.13g / 100 cal</strong></td>
              <td>👍 Balanced Classic Cheat</td>
            </tr>
            <tr>
              <td><strong>4-Piece Chicken Strips (Bare)</strong></td>
              <td>460 cal</td>
              <td>34g</td>
              <td>20g Fat / 32g Carbs</td>
