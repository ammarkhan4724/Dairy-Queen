---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { LAST_CHECKED } from '../../data/site';

// Prices (Mini/Small/Medium/Large) and Small calories match each item page.
type Row = { name: string; href: string; p: [string, string, string, string]; cal: string; note?: string };
const core: Row[] = [
  { name: 'Oreo Cookie', href: '/items/oreo-blizzard', p: ['$3.49', '$4.49', '$5.49', '$5.99'], cal: '420', note: 'Most popular' },
  { name: 'Chocolate Chip Cookie Dough', href: '/items/cookie-dough-blizzard', p: ['$3.49', '$4.49', '$5.49', '$6.49'], cal: '590' },
  { name: 'Reese’s Peanut Butter Cup', href: '/items/reeses-blizzard', p: ['$3.49', '$4.49', '$5.49', '$6.49'], cal: '600' },
  { name: 'M&M’s Milk Chocolate', href: '/items/mm-blizzard', p: ['$3.49', '$4.49', '$5.29', '$5.99'], cal: '490' },
  { name: 'Butterfinger', href: '/items/butterfinger-blizzard', p: ['$3.49', '$4.49', '$5.29', '$5.99'], cal: '470' },
  { name: 'Heath', href: '/items/heath-blizzard', p: ['$3.49', '$4.49', '$5.29', '$5.99'], cal: '480' },
  { name: 'Snickers', href: '/items/snickers-blizzard', p: ['$3.49', '$4.49', '$5.49', '$6.49'], cal: '500' },
  { name: 'Mint Oreo', href: '/items/mint-oreo-blizzard', p: ['$3.49', '$4.49', '$5.49', '$5.99'], cal: '~440' },
  { name: 'Choco Brownie Extreme', href: '/items/choco-brownie-blizzard', p: ['$3.99', '$4.79', '$5.79', '$6.49'], cal: '510' },
  { name: 'Brownie Batter', href: '/items/brownie-batter-blizzard', p: ['$3.99', '$4.79', '$5.79', '$6.49'], cal: '530' },
  { name: 'Turtle Pecan Cluster', href: '/items/turtle-pecan-blizzard', p: ['$3.99', '$4.79', '$5.79', '$6.49'], cal: '570' },
  { name: 'Strawberry Cheesequake', href: '/items/strawberry-cheesequake-blizzard', p: ['$3.99', '$4.79', '$5.79', '$6.49'], cal: '~520' },
];
const royal: Row[] = [
  { name: 'Royal Oreo', href: '/items/royal-oreo-blizzard', p: ['$3.99', '$4.99', '$5.99', '$6.49'], cal: '490', note: 'Fudge center' },
  { name: 'Royal Reese’s', href: '/items/royal-reeses-blizzard', p: ['$3.99', '$4.99', '$5.99', '$6.49'], cal: '620', note: 'Peanut butter center' },
  { name: 'Royal New York Cheesecake', href: '/items/royal-new-york-cheesecake-blizzard', p: ['$3.99', '$4.99', '$5.99', '$6.49'], cal: '460', note: 'Strawberry center' },
  { name: 'Royal Rocky Road Trip', href: '/items/royal-rocky-road-trip-blizzard', p: ['$3.99', '$4.99', '$5.99', '$6.49'], cal: '530', note: 'Fudge center' },
];
const seasonal: Row[] = [
  { name: 'Pumpkin Pie', href: '/items/pumpkin-pie-blizzard', p: ['$4.49', '$5.29', '$6.09', '$6.79'], cal: '490', note: 'Fall' },
  { name: 'Peppermint Bark', href: '/items/peppermint-bark-blizzard', p: ['$3.99', '$4.79', '$5.79', '$6.49'], cal: '500', note: 'Winter' },
  { name: 'Peppermint Hot Cocoa', href: '/items/peppermint-hot-cocoa-blizzard', p: ['$3.99', '$4.79', '$5.79', '$6.49'], cal: '~480', note: 'Winter' },
  { name: 'Frosted Sugar Cookie', href: '/items/frosted-sugar-cookie-blizzard', p: ['$3.99', '$4.79', '$5.79', '$6.49'], cal: '~510', note: 'Holiday' },
  { name: 'Banana Cream Pie', href: '/items/banana-cream-pie-blizzard', p: ['$3.99', '$4.79', '$5.79', '$6.49'], cal: '~540', note: 'Limited time' },
  { name: 'S’mores', href: '/items/smores-blizzard', p: ['$4.49', '$5.29', '$6.29', '$6.99'], cal: '500', note: 'Summer' },
  { name: 'Cotton Candy', href: '/items/cotton-candy-blizzard', p: ['$4.49', '$5.29', '$6.29', '$6.99'], cal: '460', note: 'Summer' },
  { name: 'Mixing Bowl Mashup', href: '/items/mixing-bowl-mashup-blizzard', p: ['$4.49', '$5.29', '$6.29', '$6.99'], cal: '520', note: 'Summer' },
  { name: 'Swicy Pineapple with Tajín', href: '/items/swicy-pineapple-tajin-blizzard', p: ['$4.49', '$5.29', '$6.29', '$6.99'], cal: '430', note: 'Summer' },
  { name: 'Dipped Strawberry Cheesecake', href: '/items/dipped-strawberry-cheesecake-blizzard', p: ['$4.49', '$5.29', '$6.29', '$6.99'], cal: '~540', note: 'Summer' },
  { name: 'Confetti Cake', href: '/items/confetti-cake-blizzard', p: ['$4.49', '$5.29', '$6.29', '$6.99'], cal: '~490', note: 'Summer' },
];
const groups = [
  { id: 'year-round', title: 'Year-round Blizzard flavors and prices', rows: core },
  { id: 'royal', title: 'Royal Blizzards (filled center)', rows: royal },
  { id: 'seasonal', title: 'Seasonal and limited-time Blizzards', rows: seasonal },
];

const faqs = [
  { q: 'How much is a Blizzard at Dairy Queen?', a: 'A Blizzard typically costs $3.49–$3.99 for a Mini, $4.49–$4.79 for a Small, $5.29–$5.79 for a Medium and $5.99–$6.49 for a Large. Royal and seasonal flavors cost more. Prices vary by location.' },
  { q: 'What Blizzard sizes does Dairy Queen have?', a: 'Blizzards come in Mini, Small, Medium and Large. The Mini is a good size for a snack or to try a new flavor; the Large is best for sharing.' },
  { q: 'What is the most popular Blizzard flavor?', a: 'The Oreo Cookie Blizzard is Dairy Queen’s best-known flavor and is available year-round at every location. Cookie Dough and Reese’s are also among the most ordered.' },
  { q: 'What is a Royal Blizzard?', a: 'A Royal Blizzard has a filled center, such as hot fudge or peanut butter, in addition to the usual mix-ins. It costs about 50 cents to a dollar more than the regular version.' },
  { q: 'Can you mix two Blizzard flavors?', a: 'Yes. Most stores will blend two mix-ins into one Blizzard, such as Oreo and cookie dough, for a small extra charge.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Layout
  title="Dairy Queen Blizzard Menu With Prices (2026)"
  description="Every Dairy Queen Blizzard flavor with typical 2026 prices for Mini, Small, Medium and Large, plus calories, Royal Blizzards and seasonal flavors."
  ogImage="/Images/blizzard-category.webp"
>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<Breadcrumbs items={[{"name": "Home", "href": "/"}, {"name": "Menu", "href": "/categories"}, {"name": "Blizzard Menu"}]} />

<section class="hero">
<div class="container">
<div class="hero-content">
<span class="hero-eyebrow">Every flavor · Every size · Prices checked {LAST_CHECKED}</span>
<h1>Dairy Queen Blizzard Menu With Prices</h1>
</div>
</div>
</section>

<section class="section">
  <div class="container article-body" style="max-width:960px;">
    <p class="lead"><strong>A Dairy Queen Blizzard costs about $3.49 for a Mini, $4.49 for a Small, $5.49 for a Medium and $5.99–$6.49 for a Large.</strong> Premium flavors like Choco Brownie Extreme and Turtle Pecan cost about 30 to 50 cents more per size, and Royal and seasonal Blizzards cost a bit more again. Below is every Blizzard flavor we track, with prices by size and calories.</p>
    <p>A Blizzard is DQ soft serve blended with mix-ins such as cookies, candy or brownie pieces until it is thick enough to hold upside down. It has been on the menu since 1985. Not sure which to pick? See our <a href="/blog/best-blizzard-flavors-ranked">ranking of the best Blizzard flavors</a>.</p>

    {groups.map((g) => (
      <>
        <h2 id={g.id}>{g.title}</h2>
        <div class="table-wrap">
          <table class="size-table">
            <thead><tr><th>Flavor</th><th>Mini</th><th>Small</th><th>Medium</th><th>Large</th><th>Calories (Small)</th></tr></thead>
            <tbody>
              {g.rows.map((r) => (
                <tr>
                  <td><strong><a href={r.href}>{r.name} Blizzard</a></strong>{r.note && <span style="display:block;font-size:.8rem;color:var(--color-text-muted);">{r.note}</span>}</td>
                  {r.p.map((x) => <td class="price-cell">{x}</td>)}
                  <td>{r.cal}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    ))}
    <p style="font-size:.88rem;color:var(--color-text-muted);">Typical price; varies by location. Last checked {LAST_CHECKED}. "—" means we have not confirmed that size’s price. Seasonal flavors rotate, so not every one is on the menu at the same time.</p>

    <h2 id="sizes">Blizzard sizes: which one to order</h2>
    <ul>
      <li><strong>Mini:</strong> about 300–400 calories. Good after a meal or to try a new flavor.</li>
      <li><strong>Small:</strong> the everyday size for one person.</li>
      <li><strong>Medium:</strong> a big dessert for one, or a share for two.</li>
      <li><strong>Large:</strong> around 900–1,200 calories. Best for sharing.</li>
    </ul>
    <p>Calories for every size are on each flavor’s page, and our <a href="/blog/dairy-queen-calories-nutrition-guide">DQ calories guide</a> compares lighter options.</p>

    <h2 id="royal-explained">What makes a Royal Blizzard different?</h2>
    <p>Royal Blizzards add a filled center, like hot fudge in the <a href="/items/royal-oreo-blizzard">Royal Oreo</a> or peanut butter in the <a href="/items/royal-reeses-blizzard">Royal Reese’s</a>. You get the regular mix-ins plus a gooey middle for roughly 50 cents to a dollar more.</p>

    <h2 id="seasonal-explained">Blizzard of the Month and seasonal flavors</h2>
    <p>Dairy Queen rotates limited-time Blizzards through the year: fruity and summery flavors in summer, <a href="/items/pumpkin-pie-blizzard">Pumpkin Pie</a> in fall, and peppermint flavors around the holidays. Dairy Queen also features a <a href="/blizzard-of-the-month">Blizzard of the Month</a>; our page lists the current flavor, the fall 2026 menu and every past pick.</p>

    <h2 id="ordering-tips">Tips for ordering a Blizzard</h2>
    <ul>
      <li><strong>Ask for extra mix-ins</strong> if you like more crunch. There is usually a small charge.</li>
      <li><strong>Combine two flavors.</strong> Oreo plus cookie dough is a favorite. Our <a href="/blog/dairy-queen-secret-menu">DQ secret menu guide</a> lists more combos.</li>
      <li><strong>Use the DQ app.</strong> Blizzard deals show up often. See the <a href="/blog/dairy-queen-app-rewards-hacks">DQ app rewards guide</a>.</li>
      <li><strong>Want a whole Blizzard cake?</strong> See <a href="/categories/dq-cakes">DQ Blizzard cake prices and sizes</a>.</li>
    </ul>

    <h2 id="compare">Blizzard vs. McFlurry vs. Frosty</h2>
    <p>A Blizzard is soft serve with mix-ins blended through the whole cup. A McDonald’s McFlurry is similar, but it is usually thinner and comes in fewer sizes. A Wendy’s Frosty is a thick frozen dessert without mix-ins. If you want lots of add-ins and a choice of four sizes, the Blizzard is the one to get.</p>

    <h2 id="faq">Frequently asked questions</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">{f.q}<span class="faq-icon">+</span></button>
          <div class="faq-a"><div class="faq-a-inner">{f.a}</div></div>
        </div>
      ))}
    </div>

    <p style="margin-top:32px;">More from the menu: <a href="/categories/classic-treats">cones and sundaes</a> · <a href="/categories/drinks">shakes and drinks</a> · <a href="/">full Dairy Queen menu with prices</a>.</p>
  </div>
</section>

</Layout>
