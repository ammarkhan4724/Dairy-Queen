---
import Layout from '../../layouts/Layout.astro';
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much is the DQ FlameThrower Stackburger?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The FlameThrower® Signature Stackburger is $10.87 (single) or approximately $13.49 (double). It has 780 calories and features Pepper Jack cheese, FlameThrower sauce, fresh jalapeños, lettuce, tomato, and mayo on a toasted bun."
      }
    },
    {
      "@type": "Question",
      "name": "Does DQ serve real beef?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. DQ Signature Stackburgers and all DQ burgers are made with 100% real seasoned beef, never frozen, and cooked to order at DQ Grill &amp; Chill locations."
      }
    },
    {
      "@type": "Question",
      "name": "Which DQ burger is the best value?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Original Cheeseburger at $6.39 is the best standalone value. Even better: order it as part of the $7 Meal Deal, which adds Regular Fries, a Soft Drink, and a Small Sundae for just $0.61 more."
      }
    }
  ]
};
