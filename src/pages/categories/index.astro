---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Dairy Queen Menu Categories 2026 — Complete Section Directory" description="Explore all 9 Dairy Queen menu categories for 2026: Blizzard Treats, Burgers & Sandwiches, Chicken Strip Baskets, Classic Treats, Breakfast, Drinks, and Cakes.">

<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/#full-menu">Menu</a></li>
      <li aria-current="page">Menu Categories</li>
    </ol>
  </div>
</nav>

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <span class="hero-eyebrow">Menu Sections · 2026 Guide</span>
      <h1>DAIRY QUEEN MENU CATEGORIES</h1>
      <p class="hero-lead">Browse all 9 official Dairy Queen food and treat categories with full price lists, calorie counts, and nutrition guides.</p>
      <div class="hero-cta">
        <a href="/#full-menu" class="btn btn-accent">Jump to Full Menu</a>
        <a href="/items" class="btn btn-outline">Browse All 79 Items</a>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <a href="/categories/blizzard-treats" class="cat-card group">
      <div class="cat-img aspect-video bg-amber-50/50 overflow-hidden relative">
        <img src="/Images/category-blizzards.webp" alt="Blizzard® Treats" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
        <span class="cat-badge absolute top-3 left-3 bg-[#0E7490] text-white text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">Iconic Desserts</span>
      </div>
      <div class="cat-body p-6">
        <h3 class="text-2xl font-bold text-[#0B1E38] group-hover:text-[#0E7490] transition-colors mb-2" style="font-family: 'Bebas Neue', sans-serif;">Blizzard® Treats</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">DQ's world-famous soft serve hand-blended with cookies, candy, and fruit toppings. Thick enough to hold upside down.</p>
        <span class="cat-link inline-flex items-center gap-1.5 font-bold text-xs uppercase tracking-wider text-[#0E7490]">View Category &rarr;</span>
      </div>
    </a>
    <a href="/categories/burgers-sandwiches" class="cat-card group">
      <div class="cat-img aspect-video bg-amber-50/50 overflow-hidden relative">
        <img src="/Images/category-burgers.webp" alt="Burgers & Sandwiches" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
        <span class="cat-badge absolute top-3 left-3 bg-[#0E7490] text-white text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">Signature Grill</span>
      </div>
      <div class="cat-body p-6">
        <h3 class="text-2xl font-bold text-[#0B1E38] group-hover:text-[#0E7490] transition-colors mb-2" style="font-family: 'Bebas Neue', sans-serif;">Burgers & Sandwiches</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">100% real seasoned beef Stackburgers cooked to order, crispy and grilled chicken sandwiches, and all-beef hot dogs.</p>
        <span class="cat-link inline-flex items-center gap-1.5 font-bold text-xs uppercase tracking-wider text-[#0E7490]">View Category &rarr;</span>
      </div>
    </a>
    <a href="/categories/chicken-strip-baskets" class="cat-card group">
      <div class="cat-img aspect-video bg-amber-50/50 overflow-hidden relative">
        <img src="/Images/category-chicken.webp" alt="Chicken Strip Baskets" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
        <span class="cat-badge absolute top-3 left-3 bg-[#0E7490] text-white text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">Fan Favorite</span>
      </div>
      <div class="cat-body p-6">
        <h3 class="text-2xl font-bold text-[#0B1E38] group-hover:text-[#0E7490] transition-colors mb-2" style="font-family: 'Bebas Neue', sans-serif;">Chicken Strip Baskets</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">All-white meat chicken tenderloins breaded and served with crispy fries, Texas toast, and savory country gravy.</p>
        <span class="cat-link inline-flex items-center gap-1.5 font-bold text-xs uppercase tracking-wider text-[#0E7490]">View Category &rarr;</span>
      </div>
    </a>
    <a href="/categories/classic-treats" class="cat-card group">
      <div class="cat-img aspect-video bg-amber-50/50 overflow-hidden relative">
        <img src="/Images/category-cones.webp" alt="Classic Treats & Cones" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
        <span class="cat-badge absolute top-3 left-3 bg-[#0E7490] text-white text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">Original Soft Serve</span>
      </div>
      <div class="cat-body p-6">
        <h3 class="text-2xl font-bold text-[#0B1E38] group-hover:text-[#0E7490] transition-colors mb-2" style="font-family: 'Bebas Neue', sans-serif;">Classic Treats & Cones</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">Original DQ soft serve cones, dipped cones, sundaes, Banana Splits, Peanut Buster Parfaits, and Dilly Bars.</p>
        <span class="cat-link inline-flex items-center gap-1.5 font-bold text-xs uppercase tracking-wider text-[#0E7490]">View Category &rarr;</span>
      </div>
    </a>
    <a href="/categories/breakfast" class="cat-card group">
      <div class="cat-img aspect-video bg-amber-50/50 overflow-hidden relative">
        <img src="/Images/category-breakfast.webp" alt="Breakfast Menu" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
        <span class="cat-badge absolute top-3 left-3 bg-[#0E7490] text-white text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">Morning Platter</span>
      </div>
      <div class="cat-body p-6">
        <h3 class="text-2xl font-bold text-[#0B1E38] group-hover:text-[#0E7490] transition-colors mb-2" style="font-family: 'Bebas Neue', sans-serif;">Breakfast Menu</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">Hearty morning platters, buttermilk pancakes, breakfast burritos, biscuit sandwiches, and crispy hash browns.</p>
        <span class="cat-link inline-flex items-center gap-1.5 font-bold text-xs uppercase tracking-wider text-[#0E7490]">View Category &rarr;</span>
      </div>
    </a>
    <a href="/categories/snacks-sides" class="cat-card group">
      <div class="cat-img aspect-video bg-amber-50/50 overflow-hidden relative">
        <img src="/Images/category-snacks.webp" alt="Snacks & Sides" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
        <span class="cat-badge absolute top-3 left-3 bg-[#0E7490] text-white text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">Shareable Bites</span>
      </div>
      <div class="cat-body p-6">
        <h3 class="text-2xl font-bold text-[#0B1E38] group-hover:text-[#0E7490] transition-colors mb-2" style="font-family: 'Bebas Neue', sans-serif;">Snacks & Sides</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">Wisconsin white cheddar cheese curds, golden onion rings, hot pretzel sticks with zesty queso, and crispy fries.</p>
        <span class="cat-link inline-flex items-center gap-1.5 font-bold text-xs uppercase tracking-wider text-[#0E7490]">View Category &rarr;</span>
      </div>
    </a>
    <a href="/categories/drinks" class="cat-card group">
      <div class="cat-img aspect-video bg-amber-50/50 overflow-hidden relative">
        <img src="/Images/category-drinks.webp" alt="Drinks & Shakes" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
        <span class="cat-badge absolute top-3 left-3 bg-[#0E7490] text-white text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">Beverages</span>
      </div>
      <div class="cat-body p-6">
        <h3 class="text-2xl font-bold text-[#0B1E38] group-hover:text-[#0E7490] transition-colors mb-2" style="font-family: 'Bebas Neue', sans-serif;">Drinks & Shakes</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">MooLatté frozen coffee drinks, classic hand-spun shakes, Misty Slush beverages, and refreshing fruit smoothies.</p>
        <span class="cat-link inline-flex items-center gap-1.5 font-bold text-xs uppercase tracking-wider text-[#0E7490]">View Category &rarr;</span>
      </div>
    </a>
    <a href="/categories/dq-cakes" class="cat-card group">
      <div class="cat-img aspect-video bg-amber-50/50 overflow-hidden relative">
        <img src="/Images/category-cakes.webp" alt="DQ® Cakes" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
        <span class="cat-badge absolute top-3 left-3 bg-[#0E7490] text-white text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">Celebrations</span>
      </div>
      <div class="cat-body p-6">
        <h3 class="text-2xl font-bold text-[#0B1E38] group-hover:text-[#0E7490] transition-colors mb-2" style="font-family: 'Bebas Neue', sans-serif;">DQ® Cakes</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">Layered ice cream cakes with rich fudge crunch centers, custom Blizzard cakes, and sheet cakes for celebrations.</p>
        <span class="cat-link inline-flex items-center gap-1.5 font-bold text-xs uppercase tracking-wider text-[#0E7490]">View Category &rarr;</span>
      </div>
    </a>
    <a href="/categories/kids-meals" class="cat-card group">
      <div class="cat-img aspect-video bg-amber-50/50 overflow-hidden relative">
        <img src="/Images/category-kids.webp" alt="Kids' Meals" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
        <span class="cat-badge absolute top-3 left-3 bg-[#0E7490] text-white text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">Family Friendly</span>
      </div>
      <div class="cat-body p-6">
        <h3 class="text-2xl font-bold text-[#0B1E38] group-hover:text-[#0E7490] transition-colors mb-2" style="font-family: 'Bebas Neue', sans-serif;">Kids' Meals</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">Kid-sized burgers, hot dogs, and 2pc chicken strips served with choice of fries or applesauce, milk, and a kid cone.</p>
        <span class="cat-link inline-flex items-center gap-1.5 font-bold text-xs uppercase tracking-wider text-[#0E7490]">View Category &rarr;</span>
      </div>
    </a>
    </div>
  </div>
</section>

</Layout>
