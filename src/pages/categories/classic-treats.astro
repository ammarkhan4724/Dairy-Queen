      <tbody>
        <tr><td><strong><a href="/items/vanilla-soft-serve-cone">Vanilla Soft Serve Cone</a></strong></td><td class="price-cell">$2.39</td><td>230</td><td>Classic DQ soft serve on a wafer cone with a perfect curl</td></tr>
        <tr><td><strong>Chocolate Dipped Cone</strong></td><td class="price-cell">$3.19</td><td>330</td><td>Soft serve dipped in a crispy chocolate shell</td></tr>
        <tr><td><strong>Crunchin' Cookie Dipped Cone</strong></td><td class="price-cell">$3.49</td><td>350</td><td>Soft serve dipped in a chocolatey cookie-crunch coating</td></tr>
        <tr><td><strong>Hot Fudge Sundae</strong></td><td class="price-cell">$3.79</td><td>300</td><td>Warm fudge poured generously over DQ soft serve</td></tr>
        <tr><td><strong>Strawberry Sundae</strong></td><td class="price-cell">$3.79</td><td>280</td><td>Fresh strawberry topping over DQ soft serve</td></tr>
        <tr><td><strong>Caramel Sundae</strong></td><td class="price-cell">$3.79</td><td>310</td><td>Rich caramel drizzled over DQ soft serve</td></tr>
        <tr><td><strong><a href="/items/peanut-buster-parfait">Peanut Buster® Parfait</a></strong></td><td class="price-cell">$4.99</td><td>710</td><td>Layers of soft serve, salted peanuts, and hot fudge — since 1968</td></tr>
        <tr><td><strong><a href="/items/banana-split">Banana Split</a></strong></td><td class="price-cell">$5.69</td><td>560</td><td>Three scoops on a split banana with pineapple, strawberry &amp; fudge</td></tr>
        <tr><td><strong>Dilly® Bar — Chocolate</strong></td><td class="price-cell">$1.99</td><td>210</td><td>Round soft serve on a stick, coated in crispy chocolate shell</td></tr>
        <tr><td><strong>Non-Dairy Dilly® Bar</strong></td><td class="price-cell">$2.49</td><td>220</td><td>Dairy-free frozen dessert on a stick with chocolatey coating</td></tr>
        <tr><td><strong>Buster Bar® Treat</strong></td><td class="price-cell">$2.49</td><td>440</td><td>Vanilla soft serve, peanuts, and fudge — original DQ frozen bar</td></tr>
