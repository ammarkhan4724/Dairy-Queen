---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_URL } from '../data/site';

// Keep titles in sync with each post's H1.
const groups = [
  {
    id: 'rankings', title: 'Rankings and reviews',
    posts: [
      { href: '/blog/best-blizzard-flavors-ranked', img: '/Images/blog-blizzard-flavors.webp', title: 'Best Dairy Queen Blizzard Flavors, Ranked', desc: 'Our ranking of every Blizzard flavor, with prices, calories and which size to order.' },
      { href: '/blog/best-dairy-queen-burgers-ranked', img: '/Images/flamethrower-stackburger.webp', title: 'Best Dairy Queen Burgers, Ranked', desc: 'FlameThrower, Bacon Ranch and the other Stackburgers compared by taste, price and calories.' },
      { href: '/blog/blizzard-vs-mcflurry-vs-frosty', img: '/Images/oreo-blizzard.webp', title: 'Blizzard vs. McFlurry vs. Frosty: Which Frozen Treat Wins?', desc: 'Sizes, prices, calories and flavors compared side by side, plus which one to order.' },
      { href: '/blog/dq-chicken-strip-baskets-review', img: '/Images/chicken-strip-basket-4pc.webp', title: 'DQ Chicken Strip Basket Review: 4-Piece vs 6-Piece', desc: 'What comes in each basket, what it costs, and which size is the better deal.' },
    ],
  },
  {
    id: 'saving', title: 'Deals and saving money',
    posts: [
      { href: '/blog/dq-meal-deals-guide', img: '/Images/blog-meal-deals.webp', title: 'Dairy Queen Meal Deals: $7 Meal, 2 for $5 and 2 for $7', desc: 'What each value deal includes, typical prices, and the best picks.' },
      { href: '/blog/dairy-queen-app-rewards-hacks', img: '/Images/7-meal-deal.webp', title: 'Dairy Queen App Rewards: How It Works and How to Save', desc: 'Earning points, the best rewards to redeem, birthday treats and app-only deals.' },
      { href: '/blog/dairy-queen-price-inflation-report', img: '/Images/double-cheeseburger.webp', title: 'Why Is Dairy Queen So Expensive Now?', desc: 'Why DQ prices went up, why they differ by store, and how to pay less.' },
    ],
  },
  {
    id: 'guides', title: 'Ordering guides',
    posts: [
      { href: '/blog/dq-cakes-complete-guide', img: '/Images/blog-dq-cakes.webp', title: 'Dairy Queen Cake Guide: Flavors, Cutting and Storage Tips', desc: 'Pick a flavor, plan slices, and cut and store an ice cream cake without a mess.' },
      { href: '/blog/dairy-queen-secret-menu', img: '/Images/mixing-bowl-mashup-blizzard.webp', title: 'Dairy Queen Secret Menu: What to Order and How to Ask', desc: 'Custom Blizzards and old favorites, with exactly what to say at the counter.' },
      { href: '/blog/dq-breakfast-hours-menu', img: '/Images/country-breakfast-platter.webp', title: 'Dairy Queen Breakfast Hours and Menu', desc: 'Which DQs serve breakfast, typical hours, and the breakfast menu with prices.' },
      { href: '/blog/dq-shake-moolatte-guide', img: '/Images/moolatte.webp', title: 'Dairy Queen Shakes, Malts and MooLatté', desc: 'Shake and MooLatté prices by size, shake vs. malt, and lighter drink options.' },
    ],
  },
  {
    id: 'health', title: 'Nutrition, allergies and explainers',
    posts: [
      { href: '/blog/dairy-queen-calories-nutrition-guide', img: '/Images/dilly-bar.webp', title: 'Dairy Queen Calories and Nutrition: Lighter Choices', desc: 'The lowest-calorie treats and meals, Blizzard calories by size and easy swaps.' },
      { href: '/blog/dq-gluten-free-allergen-guide', img: '/Images/non-dairy-dilly-bar.webp', title: 'Dairy Queen Gluten-Free and Allergen Guide', desc: 'What to order with a gluten, dairy or nut allergy, and how to lower the risk.' },
      { href: '/blog/discontinued-dairy-queen-items', img: '/Images/dilly-bar.webp', title: 'Discontinued Dairy Queen Menu Items: What Happened to Them', desc: 'Monkey Tails, the DQ Chipper, the Breeze and other treats DQ retired, and which you can still get.' },
      { href: '/blog/dairy-queen-ice-cream-vs-soft-serve', img: '/Images/vanilla-soft-serve-cone.webp', title: 'Is Dairy Queen Soft Serve Real Ice Cream?', desc: 'The FDA 10% milkfat rule and how DQ soft serve compares to ice cream.' },
    ],
  },
];
const all = groups.flatMap((g) => g.posts);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Dairy Queen Guides and Blog',
  url: `${SITE_URL}/blog`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: all.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE_URL}${p.href}`, name: p.title })),
  },
};
---
<Layout
  title="Dairy Queen Guides & Blog: Rankings, Deals, Secret Menu"
  description="Plain-English Dairy Queen guides: Blizzard and burger rankings, meal deals, the DQ app, cakes, the secret menu, calories and allergens."
>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<Breadcrumbs items={[{"name": "Home", "href": "/"}, {"name": "Blog"}]} />

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <span class="hero-eyebrow">Guides from an independent DQ fan site</span>
      <h1>Dairy Queen Guides, Rankings and Tips</h1>
      <p style="margin-top:14px;max-width:760px;margin-left:auto;margin-right:auto;font-size:1.05rem;line-height:1.65;opacity:.92;">
        Practical guides to ordering at Dairy Queen: which Blizzards and burgers are best, how the meal deals and app work, how to order a cake, and what to get if you are counting calories or avoiding allergens. For prices on every item, see the <a href="/" style="color:inherit;text-decoration:underline;">full Dairy Queen menu</a>.
      </p>
    </div>
  </div>
</section>

{groups.map((g) => (
  <section id={g.id} class="section">
    <div class="container">
      <h2 class="section-title" style="text-align:left;">{g.title}</h2>
      <div class="blog-grid">
        {g.posts.map((p) => (
          <article class="blog-card" style="display:flex;flex-direction:column;border-radius:20px;overflow:hidden;border:1px solid #EDE4D6;background:#ffffff;box-shadow:0 4px 20px -2px rgba(11,30,56,0.06);">
            <a href={p.href} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
              <img src={p.img} alt="" width="600" height="340" loading="lazy" style="width:100%;height:auto;display:block;" />
            </a>
            <div style="padding:22px;display:flex;flex-direction:column;flex-grow:1;">
              <h3 style="font-size:1.25rem;font-weight:700;margin:0 0 8px;line-height:1.35;">
                <a href={p.href} style="color:#0B1E38;text-decoration:none;">{p.title}</a>
              </h3>
              <p style="font-size:.92rem;color:#475569;line-height:1.6;margin:0 0 16px;flex-grow:1;">{p.desc}</p>
              <a href={p.href} class="btn btn-primary" style="align-self:flex-start;">Read guide →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
))}

<section class="section section-alt">
  <div class="container article-body" style="max-width:920px;">
    <h2>Browse the menu by category</h2>
    <ul>
      <li><a href="/categories/blizzard-treats">Blizzard menu and prices</a></li>
      <li><a href="/categories/dq-cakes">DQ cake prices and sizes</a></li>
      <li><a href="/categories/burgers-sandwiches">Burgers and sandwiches</a></li>
      <li><a href="/categories/chicken-strip-baskets">Chicken strip baskets</a></li>
      <li><a href="/categories/classic-treats">Cones, sundaes and classic treats</a></li>
      <li><a href="/categories/drinks">Shakes and drinks</a></li>
      <li><a href="/categories/breakfast">Breakfast</a></li>
      <li><a href="/combos">Deals and combos</a></li>
    </ul>
  </div>
</section>

</Layout>
