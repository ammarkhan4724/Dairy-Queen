      <tr><td><strong>Honey BBQ</strong></td><td class="price-cell">$10.49</td><td>Sweet, smoky, tangy</td><td>None</td></tr>
      <tr><td><strong>Parmesan Garlic</strong></td><td class="price-cell">$10.49</td><td>Rich, savory, garlicky</td><td>None</td></tr>
      <tr><td><strong>FlameThrower®</strong></td><td class="price-cell">$10.49</td><td>Spicy, creamy heat</td><td>Moderate-High</td></tr>
    </tbody>
  </table></div>
