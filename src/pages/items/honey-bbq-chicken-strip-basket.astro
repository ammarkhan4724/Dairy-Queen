const itemSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": "Honey BBQ Chicken Strip Basket",
      "image": "https://www.thequeendairymenu.us/Images/honey-bbq-chicken-strip-basket.webp",
      "description": "Four crispy white-meat chicken strips tossed in sweet honey BBQ sauce before serving — full flavor coverage in every bite. Served with fries, Texas toast, and a dipping sauce. $10.49.",
      "offers": {
        "@type": "Offer",
        "price": "10.49",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://www.thequeendairymenu.us/items/honey-bbq-chicken-strip-basket"
      },
      "nutrition": {
        "@type": "NutritionInformation",
        "calories": "~1,100 cal with fries and Texas toast"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much is the DQ Honey BBQ Chicken Strip Basket?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "$10.49 with approximately 1,100 calories. A $0.50 premium over the standard 4-Piece basket at $9.99."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Honey BBQ Basket spicy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Honey BBQ sauce is sweet and smoky, not spicy. For a spicy version, order the FlameThrower® Sauced Basket at the same $10.49 price."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between the plain basket and the sauced basket?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In the plain 4-Piece basket, you dip the strips into sauce yourself. In the Honey BBQ Basket, the sauce is tossed onto the strips before serving for full coverage."
          }
        }
      ]
    }
  ]
