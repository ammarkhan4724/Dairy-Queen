import Layout from '../../layouts/Layout.astro';
const itemSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": "Oreo Cookie Blizzard Treat",
      "image": "https://www.thequeendairymenu.us/Images/oreo-blizzard.webp",
      "description": "DQ's signature vanilla soft serve hand-blended completely through with real Oreo cookie pieces. Smooth, creamy, with chocolate-and-cream crunch in every spoonful from first to last. Thick enough to hold upside down — guaranteed or it's free.",
      "offers": {
        "@type": "Offer",
        "price": "3.49",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://www.thequeendairymenu.us/items/oreo-blizzard"
      },
      "nutrition": {
        "@type": "NutritionInformation",
        "calories": "420 cal"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is the Oreo Blizzard available all year?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Oreo Cookie Blizzard is a core year-round menu item at all Dairy Queen locations. Unlike seasonal Blizzard flavors, it is always available."
          }
        },
        {
          "@type": "Question",
          "name": "Does the Oreo Blizzard contain gluten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Oreo Blizzard contains wheat from the Oreo cookie pieces. It also contains milk and soy. DQ kitchens handle multiple allergens — consult the DQ allergen guide if you have a serious allergy."
          }
        },
        {
          "@type": "Question",
          "name": "What size Oreo Blizzard should I order?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Mini ($3.49, ~300 cal) is right for a quick taste or a light dessert after a meal. The Small ($4.49, 420 cal) is the everyday order for one person. The Medium ($5.49, 590 cal) is for when you know exactly what you want and want more of it. The Large ($5.99, 920 cal) is best for sharing or the truly devoted."
          }
        }
      ]
    }
  ]
};
