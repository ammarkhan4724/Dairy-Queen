---
import Layout from '../../layouts/Layout.astro';
const itemSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": "Arctic Rush Misty Slush",
      "image": "https://www.thequeendairymenu.us/Images/misty-slush.webp",
      "description": "A flavored frozen slush drink in Cherry, Blue Raspberry, Lemon-Lime, and seasonal varieties. At $2.39 for a Small, it is the most affordable drink on the DQ menu — and one of the most refreshing.",
      "offers": {
        "@type": "Offer",
        "price": "2.39",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://www.thequeendairymenu.us/items/misty-slush"
      },
      "nutrition": {
        "@type": "NutritionInformation",
        "calories": "~150 cal"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much is the DQ Misty Slush?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small $2.39, Medium $2.89, Large $3.29. The most affordable drink on the DQ menu."
          }
        },
        {
          "@type": "Question",
          "name": "What flavors does the Misty Slush come in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cherry, Blue Raspberry, Lemon-Lime, and seasonal varieties. Cherry and Blue Raspberry are the most popular."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Misty Slush dairy-free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Misty Slush contains no dairy ingredients — it is a purely fruit-flavored frozen slush drink."
          }
        }
      ]
    }
  ]
};
---
<Layout title="Dairy Queen Misty Slush — Price, Calories & Flavors 2026" description="DQ Arctic Rush Misty Slush price: from $2.39, 150+ cal. Available in Cherry, Blue Raspberry, Lemon-Lime, and seasonal flavors. Full 2026 price and flavor guide.">
<script type="application/ld+json" set:html={JSON.stringify(itemSchema)} />


<nav aria-label="Breadcrumb" class="breadcrumb"><div class="container"><ol><li><a href="/">Home</a></li><li><a href="/#full-menu">Menu</a></li><li><a href="/categories/drinks">Drinks</a></li><li aria-current="page">Misty Slush</li></ol></div></nav>

<div class="container">
  <div class="item-hero">
    <div class="item-media">
      <img src="/Images/misty-slush.webp" alt="Arctic Rush® Misty® Slush — Dairy Queen 2026 menu item" width="600" height="450" loading="eager">
    </div>
    <div>
      <div class="badge-row"><span class="badge red">Cheapest DQ Drink</span><span class="badge">4 Flavors</span><span class="badge blue">150 Cal Small</span></div>
      <h1>Arctic Rush® Misty® Slush</h1>
      <div class="item-price-lg">From $2.39</div>
      <p>Micro-crushed crystalline ice saturated with vibrant fruit syrup concoctions—poured fresh in Cherry, Electric Blue Raspberry, and zesty Lemon-Lime. Dairy Queen's premier fat-free, dairy-free frozen thirst quencher, starting at an economical $2.39 for a Small (~150 calories).</p>

      <table class="spec-table"><tbody><tr><td>Starting Price</td><td>$2.39 (Small)</td></tr><tr><td>Calories (Small)</td><td>~150 cal</td></tr><tr><td>Flavors</td><td>Cherry · Blue Raspberry · Lemon-Lime · Seasonal</td></tr><tr><td>Sizes</td><td>Small · Medium · Large</td></tr><tr><td>Zero-Fat</td><td>Yes — no fat content</td></tr></tbody></table>
    </div>
  </div>
</div>
<section class="section section-alt">
  <div class="container">
    <h2 class="section-title">Price &amp; Calories — 2026</h2>
    <div style="max-width:700px;margin:0 auto;">
      <div class="table-wrap"><table class="size-table"><thead><tr><th>Size / Option</th><th>Price</th><th>Calories</th><th>Total Fat</th></tr></thead><tbody><tr><td><strong>Small Misty Slush</strong></td><td>$2.39</td><td class="price-cell">~150 cal</td><td>0g fat</td></tr><tr><td><strong>Medium Misty Slush</strong></td><td>$2.89</td><td class="price-cell">~200 cal</td><td>0g fat</td></tr><tr><td><strong>Large Misty Slush</strong></td><td>$3.29</td><td class="price-cell">~260 cal</td><td>0g fat</td></tr><tr><td><strong>Soft Drink (medium)</strong></td><td>$2.11</td><td class="price-cell">~150–200 cal</td><td>0g fat</td></tr></tbody></table></div>
    </div>
    <p style="text-align:center;margin-top:10px;font-size:.82rem;color:var(--color-text-muted);">Prices are 2026 national averages. Local DQ prices may vary.</p>
  </div>
</section>
<section class="section">
  <div class="container article-body" style="max-width:920px;">
    <h2>Sub-Zero Hydration: The Misty Slush Experience</h2>
  <p>Formerly celebrated across generations as the Arctic Rush®, Dairy Queen's Misty® Slush delivers pure icy refreshment. Unlike carbonated frozen sodas that lose their fizz or dairy shakes that coat the throat, the Misty Slush relies on fine-grained shaved ice steeped in bold sweet-tart syrups. It provides an immediate sub-zero temperature drop that restores energy on sweltering days without adding heavy cream fats. Explore every beverage and fountain option across <a href="/">The Queen Dairy Menu</a>.</p>

  <h2>All Misty Slush Flavors</h2>
  <div class="table-wrap"><table class="size-table"><thead><tr><th>Flavor</th><th>Small Price</th><th>Small Cal</th><th>Profile</th></tr></thead><tbody><tr><td>Cherry</td><td class="price-cell">$2.39</td><td>~150 cal</td><td>Most popular — classic sweet-tart cherry</td></tr><tr><td>Blue Raspberry</td><td class="price-cell">$2.39</td><td>~150 cal</td><td>Sweet-tart, vibrant blue — fan favorite</td></tr><tr><td>Lemon-Lime</td><td class="price-cell">$2.39</td><td>~150 cal</td><td>Citrus and refreshing, least sweet</td></tr><tr><td>Seasonal varieties</td><td class="price-cell">$2.39+</td><td>~150 cal</td><td>Varies by season — check your local DQ</td></tr></tbody></table></div>

  <h2>Misty Slush vs. Other DQ Drinks</h2>
  <ul>
    <li><strong>Misty Slush vs. Soft Drink</strong> — The Misty Slush ($2.39) is slightly more expensive than a fountain drink ($2.11) but delivers the slush texture. Both have similar calorie counts at smaller sizes.</li>
    <li><strong>Misty Slush vs. MooLatté</strong> — Completely different profiles. The <a href="/items/moolatte">MooLatté</a> ($4.29) is creamy, coffee-flavored, and high-calorie. The Misty Slush is fruity, light, and low-calorie.</li>
    <li><strong>Misty Slush vs. Chocolate Shake</strong> — The <a href="/items/chocolate-shake">Chocolate Shake</a> ($3.49) is 710 cal Small vs. ~150 cal for the Misty Slush. Choose the Slush if you want a low-calorie drink option; the Shake if you want dessert in a cup.</li>
  </ul>

  <h2>When to Choose a Misty Slush</h2>
  <ul>
    <li><strong>Intense Heatwaves:</strong> When humidity spikes, nothing quenches thirst faster than real crushed ice and tart fruit syrup.</li>
    <li><strong>100% Lactose-Free &amp; Vegan:</strong> Formulated without any animal byproducts or dairy milk fat, making it an inclusive choice for guests with dietary restrictions.</li>
    <li><strong>Savory Meal Companion:</strong> Pairs cleanly with crispy fried entrees like a <a href="/items/chicken-strip-basket-4pc">Chicken Strip Basket</a>, slicing through savory grease without compounding calories.</li>
    <li><strong>Kid-Friendly Road Trips:</strong> Vibrant colors and playful flavors make it a favorite drive-thru milestone for younger family members.</li>
  </ul>

  <h2>Related Drinks</h2>
  <ul>
    <li><a href="/items/orange-julius">Orange Julius — from $3.99 (fruity but creamy)</a></li>
    <li><a href="/items/fruit-smoothies">Fruit Smoothies — from $3.99 (thicker fruit option)</a></li>
    <li><a href="/items/chocolate-shake">Chocolate Shake — from $3.49 (if you want dairy)</a></li>
    <li><a href="/categories/drinks">Full DQ Drinks Menu</a></li>
  </ul>
    <h2>Frequently Asked Questions</h2>
    <div class="faq-list"><div class="faq-item">
      <button class="faq-q" aria-expanded="false">How much is the DQ Misty Slush?<span class="faq-icon">+</span></button>
      <div class="faq-a"><div class="faq-a-inner">Small $2.39, Medium $2.89, Large $3.29. The most affordable drink on the DQ menu.</div></div>
    </div><div class="faq-item">
      <button class="faq-q" aria-expanded="false">What flavors does the Misty Slush come in?<span class="faq-icon">+</span></button>
      <div class="faq-a"><div class="faq-a-inner">Cherry, Blue Raspberry, Lemon-Lime, and seasonal varieties. Cherry and Blue Raspberry are the most popular.</div></div>
    </div><div class="faq-item">
      <button class="faq-q" aria-expanded="false">Is the Misty Slush dairy-free?<span class="faq-icon">+</span></button>
      <div class="faq-a"><div class="faq-a-inner">Yes. The Misty Slush contains no dairy ingredients — it is a purely fruit-flavored frozen slush drink.</div></div>
    </div></div>
    <p style="margin-top:32px;padding-top:18px;border-top:1px solid var(--color-border);">
      For every DQ price, flavor, and category, visit <a href="/"><strong>The Queen Dairy Menu</strong></a>.
    </p>
  </div>
</section>

</Layout>
