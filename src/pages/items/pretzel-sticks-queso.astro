---
import ItemPage from '../../layouts/ItemPage.astro';

const faqs = [
  { q: 'How much are DQ Pretzel Sticks with Queso?', a: 'They typically cost about $3.99 and have about 440 calories including the queso. Prices vary by location.' },
  { q: 'Are DQ Pretzel Sticks on the 2 for $5 menu?', a: 'At many participating DQ Grill & Chill locations, yes. They are one of the best picks on the 2 for $5 Mix & Match menu.' },
  { q: 'Are the DQ pretzel sticks soft or hard?', a: 'Soft. They are warm, chewy pretzel sticks, not crunchy pretzels.' },
  { q: 'Pretzel sticks or cheese curds?', a: 'Pretzel sticks are lighter (about 440 calories and 16 g of fat) and chewy. Cheese curds are fried, crispier and heavier (about 470 calories and 28 g of fat).' },
];
---
<ItemPage
  title="DQ Pretzel Sticks with Queso: Price & Calories"
  description="Dairy Queen Pretzel Sticks with Zesty Queso cost about $3.99 and have 440 calories. On the 2 for $5 menu, and how they compare to cheese curds."
  name="Pretzel Sticks with Zesty Queso"
  category={{ name: 'Snacks & Sides', href: '/categories/snacks-sides' }}
  image="/Images/pretzel-sticks-queso.webp"
  imageAlt="Dairy Queen soft pretzel sticks with a cup of queso"
  badges={['2 for $5 menu']}
  quick="Pretzel sticks with zesty queso at Dairy Queen cost about $3.99 and have about 440 calories including the dip. At many stores they are on the 2 for $5 menu. Prices vary by location."
  from="$3.99"
  intro="Warm, soft pretzel sticks with a cup of zesty queso for dipping. They are a good snack on their own or a side that is a little different from fries."
  spec={[
    ['Price', '$3.99'],
    ['Calories', '440 (with queso)'],
    ['Total fat', '16 g'],
    ['Deal', 'Often on the 2 for $5 Mix & Match menu'],
  ]}
  faqs={faqs}
>
  <h2>Pretzel sticks vs. other DQ sides</h2>
  <div class="table-wrap"><table class="size-table">
    <thead><tr><th>Side</th><th>Typical price</th><th>Calories</th></tr></thead>
    <tbody>
      <tr><td><strong>Pretzel sticks with queso</strong></td><td class="price-cell">$3.99</td><td>440</td></tr>
      <tr><td><a href="/items/cheese-curds">Cheese curds</a></td><td class="price-cell">$3.99</td><td>470</td></tr>
      <tr><td><a href="/items/onion-rings">Onion rings</a></td><td class="price-cell">$3.29</td><td>~400</td></tr>
      <tr><td><a href="/items/regular-fries">Small fries</a></td><td class="price-cell">$2.49</td><td>260</td></tr>
    </tbody>
  </table></div>

  <h2>Best way to order them</h2>
  <p>Get them on the <a href="/items/2-for-5-mix-match">2 for $5 menu</a> with a second item such as <a href="/items/2pc-chicken-strips">2-piece chicken strips</a>. That is one of the best-value pairings at DQ. Our <a href="/blog/dq-meal-deals-guide">meal deals guide</a> has more.</p>
  <p>See every side on the <a href="/categories/snacks-sides">DQ snacks and sides menu</a>.</p>
</ItemPage>
