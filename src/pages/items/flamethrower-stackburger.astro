  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": "FlameThrower Signature Stackburger",
      "image": "https://www.thequeendairymenu.us/Images/flamethrower-stackburger.webp",
      "description": "DQ's boldest Stackburger — Pepper Jack cheese, FlameThrower sauce, fresh jalapeños, crisp lettuce, tomato, and mayo on a toasted bun. 780 calories of building heat.",
      "offers": {
        "@type": "Offer",
        "price": "10.87",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://www.thequeendairymenu.us/items/flamethrower-stackburger"
      },
      "nutrition": {
        "@type": "NutritionInformation",
        "calories": "780 cal (single)"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is the FlameThrower Stackburger very spicy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The FlameThrower has moderate to bold heat from jalapeños and FlameThrower sauce. It builds progressively — not overwhelming for most spice fans, but clearly spicy. If you are heat-sensitive, choose the Backyard Bacon Ranch Stackburger instead."
          }
        },
        {
          "@type": "Question",
          "name": "How much is the double FlameThrower?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Double FlameThrower Stackburger is approximately $13.49, though pricing varies by location. It adds a second beef patty and increases the calorie count to approximately 1,020 calories."
          }
        },
        {
          "@type": "Question",
          "name": "What is in the FlameThrower sauce?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The FlameThrower sauce is a proprietary DQ blend. It is a creamy, spicy sauce similar to a chipotle mayo in texture with a building heat profile. The exact recipe is not publicly disclosed."
          }
        }
      ]
    }
  ]
