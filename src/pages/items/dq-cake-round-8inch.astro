      <tr><td>10-inch Price</td><td class="price-cell">$32.99+</td><td class="price-cell">$35.99–$38.74+</td></tr>
      <tr><td>Soft serve flavor</td><td>Standard DQ (vanilla/chocolate)</td><td>Specific Blizzard flavor (Oreo, Cookie Dough, etc.)</td></tr>
      <tr><td>Mix-in pieces</td><td>None</td><td>Actual Blizzard pieces throughout</td></tr>
      <tr><td>Best for</td><td>Classic flavor, tighter budget</td><td>Blizzard fans, showpiece celebration</td></tr>
    </tbody>
  </table></div>
