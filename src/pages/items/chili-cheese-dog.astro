      <tr><td>Price</td><td class="price-cell">$4.99</td><td class="price-cell">$3.99</td></tr>
      <tr><td>Calories</td><td>420 cal</td><td>330 cal</td></tr>
      <tr><td>Toppings</td><td>Chili + cheese sauce</td><td>Ketchup, mustard, onion (your choice)</td></tr>
      <tr><td>Best for</td><td>Full-flavored lunch/dinner</td><td>Simple, quick, lower calorie</td></tr>
    </tbody>
  </table></div>
  <h2>Pair It With</h2>
