import Layout from '../../layouts/Layout.astro';
const itemSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": "MooLatté Frozen Blended Coffee",
      "image": "https://www.thequeendairymenu.us/Images/moolatte.webp",
      "description": "DQ soft serve blended with real coffee into a rich, creamy frozen drink. Available in Mocha, Caramel, and Vanilla — the DQ answer to a frozen coffee shop drink at a better price point.",
      "offers": {
        "@type": "Offer",
        "price": "4.29",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://www.thequeendairymenu.us/items/moolatte"
      },
      "nutrition": {
        "@type": "NutritionInformation",
        "calories": "~490 cal"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much is the DQ MooLatté?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small $4.29, Medium $4.99, Large $5.49. 2026 national average prices."
          }
        },
        {
          "@type": "Question",
          "name": "What does the MooLatté taste like?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A frozen, creamy coffee drink — similar to a Frappuccino. The Mocha has chocolate-coffee flavor, Caramel is sweeter, and Vanilla is the most subtle."
          }
        },
        {
          "@type": "Question",
          "name": "Is the MooLatté available at all DQ locations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The MooLatté is available at DQ Grill &amp; Chill locations. Some DQ Treat-only locations may not carry it. Check your local DQ."
          }
        }
      ]
    }
  ]
};
---
<Layout title="Dairy Queen MooLatté — Price, Calories & Flavors 2026 | The Queen Dairy Menu" description="DQ MooLatté price: from $4.29. Frozen blended coffee with DQ soft serve in Mocha, Caramel, and Vanilla flavors. Full 2026 price, calorie, and flavor guide.">
<script type="application/ld+json" set:html={JSON.stringify(itemSchema)} />


<nav aria-label="Breadcrumb" class="breadcrumb"><div class="container"><ol><li><a href="/">Home</a></li><li><a href="/#full-menu">Menu</a></li><li><a href="/categories/drinks">Drinks</a></li><li><span aria-current="page">MooLatté®</span></li></ol></div></nav>

  
