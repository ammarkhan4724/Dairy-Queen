      <table class="spec-table"><tbody><tr><td>Starting Price</td><td>$4.29 (Small)</td></tr><tr><td>Calories (Mocha Small)</td><td>~490 cal</td></tr><tr><td>Flavors</td><td>Mocha · Caramel · Vanilla</td></tr><tr><td>Contains</td><td>Real coffee + DQ soft serve</td></tr><tr><td>Available At</td><td>DQ Grill &amp; Chill locations</td></tr></tbody></table>
