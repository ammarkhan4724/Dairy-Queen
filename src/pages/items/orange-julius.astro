<section class="section section-alt">
  <div class="container">
    <h2 class="section-title">Price &amp; Calories — 2026</h2>
    <div style="max-width:700px;margin:0 auto;">
      <div class="table-wrap"><table class="size-table"><thead><tr><th>Size / Option</th><th>Price</th><th>Calories</th><th>Total Fat</th></tr></thead><tbody><tr><td><strong>Small Orange Julius</strong></td><td>$3.99</td><td class="price-cell">~210 cal</td><td>~0g fat</td></tr><tr><td><strong>Medium Orange Julius</strong></td><td>$4.49</td><td class="price-cell">~280 cal</td><td>~0g fat</td></tr><tr><td><strong>Strawberry Banana Julius</strong></td><td>$4.29</td><td class="price-cell">~230 cal</td><td>~0g fat</td></tr></tbody></table></div>
    </div>
