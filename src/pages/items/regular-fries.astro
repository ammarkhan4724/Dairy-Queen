---
import Layout from '../../layouts/Layout.astro';
const itemSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": "DQ Regular Fries",
      "image": "https://www.thequeendairymenu.us/Images/regular-fries.webp",
      "description": "Crispy golden seasoned fries in small, medium, and large. Included with every Chicken Strip Basket and the $7 Meal Deal. The most ordered side on the DQ menu.",
      "offers": {
        "@type": "Offer",
        "price": "2.49",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://www.thequeendairymenu.us/items/regular-fries"
      },
      "nutrition": {
        "@type": "NutritionInformation",
        "calories": "260 cal"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much are DQ Regular Fries?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Small $2.49 (260 cal), Medium $2.99 (370 cal), Large $3.49 (480 cal). 2026 national average prices."
          }
        },
        {
          "@type": "Question",
          "name": "Are DQ fries included with the Chicken Strip Basket?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Regular Fries are included with all Chicken Strip Basket options — 4-piece, 6-piece, and all sauced versions — at no extra charge."
          }
        },
        {
          "@type": "Question",
          "name": "Can I substitute fries in the $7 Meal Deal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The $7 Meal Deal includes Regular Fries as a standard component. Substitution options vary by location."
          }
        }
      ]
    }
  ]
};
---
<Layout title="Dairy Queen Regular Fries — Price, Calories & Details 2026 | The Queen Dairy Menu" description="DQ Regular Fries price: from $2.49, 260+ calories. Crispy seasoned fries in small, medium, and large. Included with Chicken Strip Baskets and $7 Meal Deal.">
<script type="application/ld+json" set:html={JSON.stringify(itemSchema)} />


<nav aria-label="Breadcrumb" class="breadcrumb"><div class="container"><ol><li><a href="/">Home</a></li><li><a href="/#full-menu">Menu</a></li><li><a href="/categories/snacks-sides">Snacks &amp; Sides</a></li><li><span aria-current="page">Regular Fries</span></li></ol></div></nav>

  
<!-- AdX: before content -->
<div id="div-gpt-ad-thequeendairymenu_us-before_content">
  <script>
    googletag.cmd.push(function() { googletag.display('div-gpt-ad-thequeendairymenu_us-before_content'); });
  </script>
</div>

<div class="container">
  <div class="item-hero">
    <div class="item-media">
      <img src="https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=800&q=80" alt="DQ Regular Fries — Dairy Queen 2026 menu item" width="600" height="450" loading="eager">
    </div>
    <div>
      <div class="badge-row"><span class="badge red">Lightly Seasoned</span><span class="badge">Included in Meal Deals</span><span class="badge blue">Available in 3 Sizes</span></div>
      <h1>DQ Regular Fries</h1>
      <div class="item-price-lg">From $2.49</div>
      <p>Crispy golden seasoned fries in small, medium, and large. Included with every Chicken Strip Basket and the $7 Meal Deal. The most ordered side on the DQ menu.</p>
<!-- AdX: after paragraph 1 -->
<div id="div-gpt-ad-thequeendairymenu_us-paragraph">
  <script>
    googletag.cmd.push(function() { googletag.display('div-gpt-ad-thequeendairymenu_us-paragraph'); });
  </script>
</div>

      <table class="spec-table"><tbody><tr><td>Starting Price</td><td>$2.49 (small)</td></tr><tr><td>Calories (Small)</td><td>260 cal</td></tr><tr><td>Sizes</td><td>Small · Medium · Large</td></tr><tr><td>Included With</td><td>Chicken Strip Basket, $7 Meal Deal</td></tr><tr><td>Also In</td><td>2-for-$5 Mix &amp; Match (eligible item)</td></tr></tbody></table>
    </div>
  </div>
</div>

<section class="section section-alt">
  <div class="container">
    <h2 class="section-title">Price &amp; Calories by Size — 2026</h2>
    <div style="max-width:700px;margin:0 auto;">
      <div class="table-wrap"><table class="size-table"><thead><tr><th>Size / Option</th><th>Price</th><th>Calories</th><th>Total Fat</th></tr></thead><tbody><tr><td><strong>Small Fries</strong></td><td>$2.49</td><td class="price-cell">260 cal</td><td>12g</td></tr><tr><td><strong>Medium Fries</strong></td><td>$2.99</td><td class="price-cell">370 cal</td><td>17g</td></tr><tr><td><strong>Large Fries</strong></td><td>$3.49</td><td class="price-cell">480 cal</td><td>23g</td></tr></tbody></table></div>
    </div>
    <p style="text-align:center;margin-top:10px;font-size:.82rem;color:var(--color-text-muted);">Prices are 2026 national averages. Your local DQ may vary slightly.</p>
  </div>
</section>

<section class="section">
  <div class="container article-body" style="max-width:920px;">
    <h2>DQ Fries — The Most Ordered Side</h2>
  <p>Regular Fries are included in every <a href="/items/chicken-strip-basket-4pc">Chicken Strip Basket</a> and the <a href="/items/7-meal-deal">$7 Meal Deal</a> — making them the most eaten side at DQ by sheer volume. When ordered separately, a Small at $2.49 (260 cal) is the right size to accompany a burger or sandwich. Find the full DQ sides menu on <a href="/">The Queen Dairy Menu</a>.</p>
  <h2>DQ Fries vs. Other Sides</h2>
  <div class="table-wrap"><table class="size-table">
    <thead><tr><th>Side</th><th>Price</th><th>Calories</th><th>Notes</th></tr></thead>
    <tbody>
      <tr><td><strong>Regular Fries (small)</strong></td><td class="price-cell">$2.49</td><td>260</td><td>Most versatile, lowest price</td></tr>
      <tr><td><strong>Onion Rings</strong></td><td class="price-cell">$3.29+</td><td>400+</td><td>Thicker, more indulgent</td></tr>
      <tr><td><strong>Cheese Curds</strong></td><td class="price-cell">$3.99</td><td>470</td><td>Shareable, best with a group</td></tr>
      <tr><td><strong>Pretzel Sticks with Queso</strong></td><td class="price-cell">$3.99</td><td>440</td><td>Soft pretzels + queso dip</td></tr>
      <tr><td><strong>Side Salad</strong></td><td class="price-cell">$3.29</td><td>90</td><td>Lightest option</td></tr>
    </tbody>
  </table></div>
  <h2>Fries as Part of DQ Deals</h2>
  <ul>
    <li><strong>Included with every Chicken Strip Basket</strong> (4-pc, 6-pc, and all sauced versions) — no extra charge</li>
    <li><strong>Included in the <a href="/items/7-meal-deal">$7 Meal Deal</a></strong> — Regular Fries is one of the four deal components</li>
    <li><strong>Eligible for the <a href="/items/2-for-5-mix-match">2-for-$5 Mix &amp; Match</a></strong> — pair fries with a cheeseburger or chili dog for $5.00 total</li>
  </ul>
    <h2>Frequently Asked Questions</h2>
    <div class="faq-list"><div class="faq-item">
        <button class="faq-q" aria-expanded="false">How much are DQ Regular Fries?<span class="faq-icon">+</span></button>
        <div class="faq-a"><div class="faq-a-inner">Small $2.49 (260 cal), Medium $2.99 (370 cal), Large $3.49 (480 cal). 2026 national average prices.</div></div>
      </div><div class="faq-item">
        <button class="faq-q" aria-expanded="false">Are DQ fries included with the Chicken Strip Basket?<span class="faq-icon">+</span></button>
        <div class="faq-a"><div class="faq-a-inner">Yes. Regular Fries are included with all Chicken Strip Basket options — 4-piece, 6-piece, and all sauced versions — at no extra charge.</div></div>
      </div><div class="faq-item">
        <button class="faq-q" aria-expanded="false">Can I substitute fries in the $7 Meal Deal?<span class="faq-icon">+</span></button>
        <div class="faq-a"><div class="faq-a-inner">The $7 Meal Deal includes Regular Fries as a standard component. Substitution options vary by location.</div></div>
      </div></div>
    <p style="margin-top:32px;padding-top:18px;border-top:1px solid var(--color-border);">
      For the complete 2026 DQ food and treats menu, visit <a href="/"><strong>The Queen Dairy Menu</strong></a>.
      See all Blizzard flavors on the <a href="/categories/blizzard-treats">Blizzard Treats</a> page.
    </p>
  </div>
</section>

<section class="section section-alt">
  <div class="container article-body" style="max-width:920px;">
    <h2>Regular Fries — Value Across All Three DQ Deals</h2>
    <p>DQ Regular Fries are included in three different ways on <a href="/">The Queen Dairy Menu</a>:</p>
    <ul>
      <li><strong>Included with every Chicken Strip Basket</strong> — 4-piece ($9.99), 6-piece ($13.49), and all sauced baskets ($10.49)</li>
      <li><strong>Included in the <a href="/items/7-meal-deal">$7 Meal Deal</a></strong> as one of four components</li>
      <li><strong>Eligible for the <a href="/items/2-for-5-mix-match">2-for-$5 Mix &amp; Match</a></strong> — pair with a cheeseburger or chili dog for $5.00</li>
    </ul>
    <h2>How to Get Fries at the Best Price</h2>
    <div class="table-wrap"><table class="size-table">
      <thead><tr><th>Method</th><th>Fries Cost</th><th>Notes</th></tr></thead>
      <tbody>
        <tr><td><strong>As part of Chicken Strip Basket</strong></td><td class="price-cell">$0 (included)</td><td>Best deal — already in $9.99 basket price</td></tr>
        <tr><td><strong>As part of $7 Meal Deal</strong></td><td class="price-cell">~$0 (included)</td><td>Included in $7 total for 4 items</td></tr>
        <tr><td><strong>Via 2-for-$5 + one other item</strong></td><td class="price-cell">~$2.50 effective</td><td>Pair with cheeseburger or chili dog</td></tr>
        <tr><td><strong>Ordered alone (Small)</strong></td><td class="price-cell">$2.49</td><td>Full price, standalone order</td></tr>
      </tbody>
    </table></div>
    <h2>Related Items</h2>
    <ul>
      <li><a href="/items/onion-rings">Onion Rings — $3.29+ (ring alternative)</a></li>
      <li><a href="/items/cheese-curds">Cheese Curds — $3.99 (premium side)</a></li>
      <li><a href="/items/7-meal-deal">$7 Meal Deal (fries included)</a></li>
      <li><a href="/items/chicken-strip-basket-4pc">Chicken Strip Basket (fries included)</a></li>
      <li><a href="/categories/snacks-sides">All DQ Snacks &amp; Sides</a></li>
    </ul>
  </div>
</section>

</Layout>
