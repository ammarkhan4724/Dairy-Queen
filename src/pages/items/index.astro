---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---
<Layout title="Dairy Queen Menu Items: All 79 Items With Prices" description="All 79 Dairy Queen menu items in one list with typical 2026 prices and calories: Blizzards, burgers, chicken, treats, drinks, breakfast and cakes.">

<Breadcrumbs items={[{"name": "Home", "href": "/"}, {"name": "Menu", "href": "/categories"}, {"name": "All Menu Items"}]} />

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <span class="hero-eyebrow">Full Catalog · 2026 Prices</span>
      <h1>All Dairy Queen Menu Items With Prices</h1>
      <p class="hero-lead">Every Dairy Queen item we track, by category, with typical prices and calories. Prices vary by location; tap any item for sizes and details.</p>
      <div class="hero-cta">
        <a href="/#full-menu" class="btn btn-accent">Jump to Category Menu</a>
        <a href="/categories" class="btn btn-outline">View Categories</a>
      </div>
    </div>
  </div>
</section>

<section class="section">
