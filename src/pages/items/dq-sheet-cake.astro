          }
        },
        {
          "@type": "Question",
          "name": "How far in advance do I need to order a DQ Sheet Cake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At least 48 hours in advance. For large events or peak seasons like summer, more notice is recommended."
          }
        },
        {
          "@type": "Question",
          "name": "Does the DQ Sheet Cake come in Blizzard flavors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Sheet Cake is available in the classic DQ soft serve flavor. Blizzard Cake formats (Oreo, Cookie Dough, etc.) are typically available in 10-inch round only. Confirm with your local DQ."
