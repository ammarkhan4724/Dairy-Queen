  <script>
    googletag.cmd.push(function() { googletag.display('div-gpt-ad-thequeendairymenu_us-before_content'); });
  </script>
</div>

<div class="container"><div class="item-hero">
  <div class="item-media"><img src="/Images/original-cheeseburger.webp" alt="Original Cheeseburger — Dairy Queen" loading="eager" width="600" height="450"></div>
