    googletag.cmd.push(function() { googletag.display('div-gpt-ad-thequeendairymenu_us-paragraph'); });
  </script>
</div>

    <table class="spec-table"><tbody><tr><td>Price</td><td>$6.39 (single) · $7.99 (double)</td></tr><tr><td>Calories</td><td>400 cal (single)</td></tr><tr><td>Total Fat</td><td>18g</td></tr><tr><td>Sodium</td><td>910mg</td></tr><tr><td>Beef</td><td>100% real seasoned beef, never frozen</td></tr></tbody></table>
