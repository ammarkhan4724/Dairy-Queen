import Layout from '../../layouts/Layout.astro';
const itemSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "name": "Original Cheeseburger",
      "image": "https://www.thequeendairymenu.us/Images/original-cheeseburger.webp",
      "description": "100% real seasoned beef with American cheese, ketchup, mustard, dill pickles, and onion on a toasted bun. Simple, classic, reliable. $6.39.",
      "offers": {
        "@type": "Offer",
        "price": "6.39",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://www.thequeendairymenu.us/items/original-cheeseburger"
      },
      "nutrition": {
        "@type": "NutritionInformation",
        "calories": "400 cal (single)"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much is the DQ Original Cheeseburger?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "$6.39 (single, 400 cal). The Double is $7.99 (560 cal)."
          }
        },
        {
          "@type": "Question",
          "name": "What is on the DQ Original Cheeseburger?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Beef patty, American cheese, ketchup, mustard, dill pickles, and chopped onion on a toasted bun."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Original Cheeseburger in the $7 Meal Deal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Original Cheeseburger is one of two entree options in the $7 Meal Deal, which adds Regular Fries, a Soft Drink, and a Small Sundae for $7.00 total."
          }
        }
      ]
    }
  ]
};
---
<Layout title="Dairy Queen Original Cheeseburger — Price, Calories & Details 2026 | The Queen Dairy Menu" description="DQ Original Cheeseburger price: $6.39, 400 calories. 100% beef, American cheese, ketchup, mustard, pickles, onion. Best value DQ burger and $7 Meal Deal entree.">
<script type="application/ld+json" set:html={JSON.stringify(itemSchema)} />


<nav aria-label="Breadcrumb" class="breadcrumb"><div class="container"><ol>
<li><a href="/">Home</a></li><li><a href="/#full-menu">Menu</a></li>
<li><a href="/categories/burgers-sandwiches">Burgers &amp; Sandwiches</a></li>
<li aria-current="page">Original Cheeseburger</li></ol></div></nav>

  
<!-- AdX: before content -->
