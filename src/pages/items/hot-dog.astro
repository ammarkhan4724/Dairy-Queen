    <li><a href="/items/2-for-5-mix-match">2-for-$5 Mix &amp; Match (Hot Dog eligible)</a></li>
    <li><a href="/items/original-cheeseburger">Original Cheeseburger — $6.39</a></li>
    <li><a href="/categories/burgers-sandwiches">All DQ Burgers &amp; Sandwiches</a></li>
  </ul>
