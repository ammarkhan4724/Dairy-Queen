  "@graph": [
    {
      "@type": "Product",
      "name": "Kids 2-Piece Chicken Strips Meal",
      "image": "https://www.thequeendairymenu.us/Images/kids-chicken-strips-meal.webp",
      "description": "Two crispy white-meat chicken strips, Fries or Applesauce, Milk or Soft Drink, and a Vanilla Soft Serve Cone. A complete kids meal for $4.99.",
      "offers": {
        "@type": "Offer",
        "price": "4.99",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://www.thequeendairymenu.us/items/kids-chicken-strips-meal"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much is the DQ Kids 2-Piece Chicken Strips Meal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "$4.99 — includes the entrée, Fries or Applesauce, Milk or Soft Drink, and a Vanilla Soft Serve Cone."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Vanilla Soft Serve Cone really free in the Kids Meal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Vanilla Soft Serve Cone (normally $2.39) is included in every DQ Kids Meal at no extra charge within the $4.99 price."
          }
        },
        {
          "@type": "Question",
          "name": "What is the healthiest DQ Kids Meal choice?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Choose Applesauce instead of Fries and 1% Milk instead of Soft Drink to get the lowest-calorie, most nutritionally balanced Kids Meal."
          }
        }
      ]
    }
  ]
