<div class="table-wrap"><table class="size-table">
<thead><tr><th>Drink</th><th>Small Price</th><th>Small Cal</th><th>Texture</th><th>Dairy-Free?</th></tr></thead>
<tbody>
<tr><td><strong>Fruit Smoothie</strong></td><td class="price-cell">$3.99</td><td>~220</td><td>Thick, blended</td><td>Yes</td></tr>
<tr><td><strong><a href="/items/orange-julius">Orange Julius</a></strong></td><td class="price-cell">$3.99</td><td>~210</td><td>Frothy, light</td><td>Yes</td></tr>
<tr><td><strong><a href="/items/misty-slush">Misty Slush</a></strong></td><td class="price-cell">$2.39</td><td>~150</td><td>Icy slush</td><td>Yes</td></tr>
<tr><td><strong><a href="/items/chocolate-shake">Chocolate Shake</a></strong></td><td class="price-cell">$3.49</td><td>~710</td><td>Very thick, creamy</td><td>No</td></tr>
