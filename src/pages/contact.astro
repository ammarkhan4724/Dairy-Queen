---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — The Dairy Queen Menu" description="Contact The Dairy Queen Menu. Report pricing errors, suggest content improvements, or ask questions about the site.">

<nav aria-label="Breadcrumb" class="breadcrumb">
<div class="container">
<ol><li><a href="/">Home</a></li><li aria-current="page">Contact Us</li></ol>
</div>
</nav>

  
<!-- AdX: before content -->
<div id="div-gpt-ad-thedairyqueenmenu_us-before_content">
  <script>
    googletag.cmd.push(function() { googletag.display('div-gpt-ad-thedairyqueenmenu_us-before_content'); });
  </script>
</div>

  <section class="section">
    <div class="container article-body">
      <h1>Contact Us</h1>
<p>Have a question, found an error, or want to suggest an improvement? We want to hear from you.</p>
<!-- AdX: after paragraph 1 -->
<div id="div-gpt-ad-thedairyqueenmenu_us-paragraph">
  <script>
    googletag.cmd.push(function() { googletag.display('div-gpt-ad-thedairyqueenmenu_us-paragraph'); });
  </script>
</div>

    <h2>What We Can Help With</h2>
    <ul>
      <li>Reporting outdated or incorrect prices</li>
      <li>Notifying us of menu changes or new items</li>
      <li>Corrections to calorie or nutrition information</li>
      <li>General questions about the site</li>
    </ul>
    <h2>What We Cannot Help With</h2>
    <p>We are not affiliated with Dairy Queen® and cannot help with: complaints about a DQ location, gift card issues, DQ app problems, franchise inquiries, or employment questions. For those matters, contact <a href="https://www.dairyqueen.com/en-us/contact/" target="_blank" rel="noopener noreferrer">Dairy Queen directly</a>.</p>
    <h2>Email</h2>
    <p>Reach us at: <strong><a href="mailto:hello@thedairyqueenmenu.us">hello@thedairyqueenmenu.us</a></strong></p>
    <p>We aim to respond within 2–3 business days.</p>
    </div>
  </section>

</Layout>
