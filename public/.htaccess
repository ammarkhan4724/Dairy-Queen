# Canonical URL form: https://www.thequeendairymenu.us/path  (no trailing slash, no .html)
# Pages are built as flat files (astro.config.mjs: build.format "file"), e.g. /items/oreo-blizzard.html

# Stop Apache from appending "/" to folder names (e.g. /items -> /items/), which
# was the cause of the duplicate slash / no-slash URLs in Search Console.
DirectorySlash Off
Options -MultiViews -Indexes

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Any URL ending in "/" (except the homepage) -> one 301 to the clean canonical URL.
  #    Runs first and targets https://www directly, so http/non-www slash URLs are a single hop.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+?)/+$ https://www.thequeendairymenu.us/$1 [L,R=301]

  # 2. /index.html and /folder/index.html -> / and /folder
  RewriteCond %{THE_REQUEST} \s/+(.*?)/?index\.html[\s?] [NC]
  RewriteRule ^ https://www.thequeendairymenu.us/%1 [L,R=301]

  # 3. /page.html -> /page (only when requested directly, not after rule 5's internal rewrite)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteCond %1 !^404$
  RewriteRule ^ https://www.thequeendairymenu.us/%1 [L,R=301]

  # 4. Force HTTPS and www.thequeendairymenu.us
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^thequeendairymenu\.us$ [NC]
  RewriteRule ^(.*)$ https://www.thequeendairymenu.us/$1 [L,R=301]

  # 5. Serve /page from /page.html (internal rewrite, URL stays clean, returns 200)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Security Headers (RankSEO 7/7 Audit Compliance)
<IfModule mod_headers.c>
  # 1. HSTS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # 2. X-Frame-Options
  Header always set X-Frame-Options "SAMEORIGIN"

  # 3. X-Content-Type-Options
  Header always set X-Content-Type-Options "nosniff"

  # 4. Referrer-Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # 5. Permissions-Policy
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # 6. X-XSS-Protection
  Header always set X-XSS-Protection "1; mode=block"

  # 7. Content-Security-Policy (allows self, Google Ads, GA4, GTM, fonts)
  Header always set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://pagead2.googlesyndication.com https://www.googletagmanager.com https://securepubads.g.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https: data:; connect-src 'self' https://www.google-analytics.com https://pagead2.googlesyndication.com; frame-src 'self' https://googleads.g.doubleclick.net https://tpc.googlesyndication.com;"
</IfModule>

# Static Asset Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
